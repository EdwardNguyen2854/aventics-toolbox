(Dialog aventics_inspection
  (Components
    (Label InspTitle) (Label InspDescription) (Label InspTargetTitle) (Label InspActiveAsm)
    (Label InspSourceTitle) (Label InspFolderLabel) (InputPanel InspFolder) (PushButton InspBrowseButton)
    (Label InspDiscoveryLabel) (CheckButton InspRecursive) (CheckButton InspLatest)
    (Label InspTypesLabel) (CheckButton InspParts) (CheckButton InspAssemblies) (CheckButton InspStep)
    (Label InspFamilyGroupLabel) (CheckButton InspFamily) (CheckButton InspGeneric) (Label InspFound)
    (Label InspPlacementTitle) (Label InspArrangementLabel) (CheckButton InspArrange)
    (Label InspDirectionLabel) (CheckButton InspRowsAlongX) (Label InspPlaneLabel) (CheckButton InspUseZAxis)
    (Label InspGridLabel) (Label InspColumnsLabel) (InputPanel InspColumns) (Label InspGapLabel) (InputPanel InspGap)
    (Label InspValidation) (PushButton InspBuildButton)
    (ProgressBar InspProgress) (Label InspProgressText) (Label InspResultsTitle)
    (Table InspTable) (Label InspSummary) (Label InspDetails)
    (PushButton InspClearButton) (Label InspSpacer)
    (Label FooterStatus) (PushButton FooterCancelButton) (PushButton FullScreenButton)
    (PushButton ControlPanelButton) (PushButton CloseButton))
  (Resources
    (.Label "Aventics Toolbox v0.5.2 - Inspection Builder")
    (.Resizeable True) (.RememberSize True)
    (InspTitle.Label "Inspection Builder")
    (InspDescription.Label "Batch assembly placement")
    (InspTargetTitle.Label "TARGET") (InspActiveAsm.Label "No active assembly")
    (InspSourceTitle.Label "SOURCE") (InspFolderLabel.Label "Folder")
    (InspFolder.Columns 42) (InspBrowseButton.Label "Browse")
    (InspDiscoveryLabel.Label "Folder options")
    (InspRecursive.Label "Include subfolders")
    (InspLatest.Label "Latest only") (InspLatest.Set True)
    (InspTypesLabel.Label "Models")
    (InspParts.Label "Parts") (InspParts.Set True)
    (InspAssemblies.Label "Assemblies") (InspAssemblies.Set True)
    (InspStep.Label "STEP") (InspStep.Set True)
    (InspFamilyGroupLabel.Label "Family tables")
    (InspFamily.Label "Instances") (InspFamily.Set True)
    (InspGeneric.Label "Include generic")
    (InspFound.Label "Choose a source folder")
    (InspPlacementTitle.Label "PLACEMENT")
    (InspArrangementLabel.Label "Mode")
    (InspArrange.Label "Auto arrange") (InspArrange.Set True)
    (InspDirectionLabel.Label "Rows")
    (InspRowsAlongX.Label "Along X (off = Y)")
    (InspPlaneLabel.Label "Plane")
    (InspUseZAxis.Label "X-Z (off = X-Y)")
    (InspGridLabel.Label "Grid")
    (InspColumnsLabel.Label "Columns") (InspColumns.Columns 5)
    (InspGapLabel.Label "Gap") (InspGap.Columns 8)
    (InspValidation.Label "") (InspBuildButton.Label "Build assembly")
    (InspProgress.MinInteger 0) (InspProgress.MaxInteger 1) (InspProgress.Integer 0)
    (InspProgressText.Label "Ready") (InspResultsTitle.Label "RESULTS")
    (InspTable.RowNames "empty")
    (InspTable.ColumnNames "Source" "Kind" "AddedModel" "Status" "FeatureId")
    (InspTable.ColumnLabels "Source" "Kind" "Added model" "Status" "Feature")
    (InspTable.ColumnWidths 29 14 29 12 9) (InspTable.VisibleRows 13)
    (InspTable.ShowGrid True) (InspTable.AttachLeft True) (InspTable.AttachRight True)
    (InspTable.AttachTop True) (InspTable.AttachBottom True)
    (InspSummary.Label "No results")
    (InspDetails.Label "Select a result for placement details.")
    (InspClearButton.Label "Clear") (InspSpacer.Label "")
    (FooterStatus.Label "Ready") (FooterCancelButton.Label "Cancel")
    (FullScreenButton.Label "Maximize / restore") (ControlPanelButton.Label "Toolbox") (CloseButton.Label "Close")
    (.Layout
      (Grid (Rows 1 0) (Cols 1)
        (Grid (Rows 0 0 0 0 0 1 0 0) (Cols 1)
          (Grid (Rows 0) (Cols 0 0 1 0 0) ControlPanelButton InspTitle InspDescription FullScreenButton CloseButton)
          (Grid (Rows 0) (Cols 0 1) InspTargetTitle InspActiveAsm)
          (Grid (Rows 0) (Cols 1 1)
            (Grid (Rows 0 0 0 0 0 0) (Cols 1)
              InspSourceTitle
              (Grid (Rows 0) (Cols 0 1 0) InspFolderLabel InspFolder InspBrowseButton)
              (Grid (Rows 0) (Cols 0 0 0) InspDiscoveryLabel InspRecursive InspLatest)
              (Grid (Rows 0) (Cols 0 0 0 0) InspTypesLabel InspParts InspAssemblies InspStep)
              (Grid (Rows 0) (Cols 0 0 0) InspFamilyGroupLabel InspFamily InspGeneric)
              InspFound)
            (Grid (Rows 0 0 0 0 0) (Cols 1)
              InspPlacementTitle
              (Grid (Rows 0) (Cols 0 0) InspArrangementLabel InspArrange)
              (Grid (Rows 0) (Cols 0 0 0 0) InspDirectionLabel InspRowsAlongX InspPlaneLabel InspUseZAxis)
              (Grid (Rows 0) (Cols 0 0 0 0 0) InspGridLabel InspColumnsLabel InspColumns InspGapLabel InspGap)
              InspValidation))
          (Grid (Rows 0) (Cols 0 1 0) InspBuildButton InspProgress InspProgressText)
          (Grid (Rows 0) (Cols 0 1) InspResultsTitle InspSummary)
          InspTable
          InspDetails
          (Grid (Rows 0) (Cols 1 0) InspSpacer InspClearButton))
        (Grid (Rows 0) (Cols 1 0) FooterStatus FooterCancelButton)))))
